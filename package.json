{
  "name": "@alexify/kerberos",
  "version": "3.1.0",
  "description": "Fast, zero-dependency in-process authorization engine for Node.js and browsers — ABAC, RBAC and ReBAC (Zanzibar-style relations) with Cerbos-like policies, caveats, OpenTelemetry and pluggable validation/caching",
  "main": "index.js",
  "bin": {
    "kerberos": "bin/kerberos.js"
  },
  "browser": {
    "./index.js": "./browser.js",
    "./src/runtime/node.js": "./src/runtime/browser.js",
    "./loader.js": "./src/loader/browser.js",
    "./src/loader/index.js": "./src/loader/browser.js"
  },
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./browser.js",
      "default": "./index.js"
    },
    "./tests": {
      "types": "./tests.d.ts",
      "default": "./tests.js"
    },
    "./relations": {
      "types": "./relations.d.ts",
      "default": "./relations.js"
    },
    "./cerbos": {
      "types": "./cerbos.d.ts",
      "default": "./cerbos.js"
    },
    "./loader": {
      "types": "./loader.d.ts",
      "browser": "./src/loader/browser.js",
      "default": "./loader.js"
    }
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:coverage": "c8 --all --include 'src/**' --check-coverage --lines 95 --statements 95 --branches 90 --functions 95 --reporter text --reporter lcov node --test test/*.test.js",
    "test:types": "tsd",
    "test:conformance": "node --test conformance/*.test.js",
    "bench": "node bench/bench.js",
    "lint": "oxlint src test scripts bench conformance bin",
    "format": "oxfmt src test scripts bench conformance bin",
    "format:check": "oxfmt --check src test scripts bench conformance bin",
    "size": "node scripts/size.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "bench:compare": "node bench/compare.js",
    "size:compare": "node scripts/size-compare.js"
  },
  "tsd": {
    "directory": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexis-Technologies/kerberos.git"
  },
  "keywords": [
    "kerberos",
    "authorization",
    "security",
    "auth",
    "policy",
    "access control",
    "cerbos",
    "framework",
    "schema",
    "web",
    "abac",
    "rbac",
    "rebac",
    "zanzibar",
    "spicedb",
    "openfga",
    "fine-grained-authorization",
    "permissions",
    "policy-as-code",
    "derived-roles",
    "opentelemetry"
  ],
  "author": "Alex Dolid <dolid.sasha@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Alexis-Technologies/kerberos/issues"
  },
  "homepage": "https://kerberosjs.vercel.app/",
  "devDependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@casl/ability": "^7.0.1",
    "@cerbos/orm-drizzle": "^0.1.0",
    "@cerbos/orm-prisma": "^4.1.0",
    "@jsep-plugin/new": "^1.0.4",
    "@jsep-plugin/object": "^1.2.2",
    "@jsep-plugin/ternary": "^1.1.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.9.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@prisma/client": "^7.10.0",
    "@sinclair/typebox": "^0.34.48",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ajv": "^8.18.0",
    "c8": "^10.1.3",
    "casbin": "^5.51.1",
    "cytoscape": "^3.34.0",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dayjs": "^1.11.21",
    "debug": "^4.4.3",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.1",
    "jsep": "^1.4.0",
    "keyv": "^5.6.0",
    "mermaid": "^11.16.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "pino": "^10.3.1",
    "tsd": "^0.31.2",
    "typescript": "^5.8.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "yaml": "^2.9.0",
    "zod": "^4.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.34.5",
  "files": [
    "index.js",
    "index.d.ts",
    "browser.js",
    "tests.js",
    "tests.d.ts",
    "relations.js",
    "relations.d.ts",
    "cerbos.js",
    "cerbos.d.ts",
    "loader.js",
    "loader.d.ts",
    "bin/",
    "src/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "package.json"
  ]
}
