{
  "name": "@alexify/kerberos",
  "version": "2.0.1",
  "description": "Fast and low overhead authorization framework for JavaScript runtime",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./tests": {
      "types": "./tests.d.ts",
      "default": "./tests.js"
    }
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:types": "tsd",
    "lint": "oxlint src test",
    "format": "oxfmt src test",
    "format:check": "oxfmt src test --check"
  },
  "tsd": {
    "directory": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexis-Technologies/kerberos.git"
  },
  "keywords": [
    "kerberos",
    "authorization",
    "authentication",
    "security",
    "auth",
    "policy",
    "access control",
    "cerbos",
    "framework",
    "schema",
    "web"
  ],
  "author": "Alex Dolid <dolid.sasha@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Alexis-Technologies/kerberos/issues"
  },
  "homepage": "https://alexis.dev",
  "devDependencies": {
    "@jsep-plugin/new": "^1.0.4",
    "@jsep-plugin/object": "^1.2.2",
    "@jsep-plugin/ternary": "^1.1.4",
    "@sinclair/typebox": "^0.34.48",
    "ajv": "^8.18.0",
    "jsep": "^1.4.0",
    "keyv": "^5.6.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "pino": "^10.3.1",
    "tsd": "^0.31.2",
    "typescript": "^5.8.3",
    "zod": "^4.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "pre-commit": [
    "lint",
    "test"
  ],
  "packageManager": "pnpm@11.5.0",
  "files": [
    "index.js",
    "index.d.ts",
    "tests.js",
    "tests.d.ts",
    "src/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "package.json",
    "pnpm-lock.yaml"
  ]
}
