{
  "name": "@alexify/kerberos",
  "version": "2.0.1",
  "description": "Fast, zero-dependency in-process authorization engine for Node.js and browsers — ABAC, RBAC and ReBAC (Zanzibar-style relations) with Cerbos-like policies, caveats, OpenTelemetry and pluggable validation/caching",
  "main": "index.js",
  "browser": {
    "./index.js": "./browser.js",
    "./src/runtime/node.js": "./src/runtime/browser.js"
  },
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./browser.js",
      "default": "./index.js"
    },
    "./tests": {
      "types": "./tests.d.ts",
      "default": "./tests.js"
    },
    "./relations": {
      "types": "./relations.d.ts",
      "default": "./relations.js"
    }
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:coverage": "c8 --all --include 'src/**' --check-coverage --lines 95 --statements 95 --branches 90 --functions 95 --reporter text --reporter lcov node --test test/*.test.js",
    "test:types": "tsd",
    "bench": "node bench/bench.js",
    "lint": "oxlint src test",
    "format": "oxfmt src test",
    "format:check": "oxfmt src test --check"
  },
  "tsd": {
    "directory": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexis-Technologies/kerberos.git"
  },
  "keywords": [
    "kerberos",
    "authorization",
    "security",
    "auth",
    "policy",
    "access control",
    "cerbos",
    "framework",
    "schema",
    "web",
    "abac",
    "rbac",
    "rebac",
    "zanzibar",
    "spicedb",
    "openfga",
    "fine-grained-authorization",
    "permissions",
    "policy-as-code",
    "derived-roles",
    "opentelemetry"
  ],
  "author": "Alex Dolid <dolid.sasha@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Alexis-Technologies/kerberos/issues"
  },
  "homepage": "https://alexis.dev",
  "devDependencies": {
    "@jsep-plugin/new": "^1.0.4",
    "@jsep-plugin/object": "^1.2.2",
    "@jsep-plugin/ternary": "^1.1.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.9.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@sinclair/typebox": "^0.34.48",
    "ajv": "^8.18.0",
    "c8": "^12.0.0",
    "jsep": "^1.4.0",
    "keyv": "^5.6.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "pino": "^10.3.1",
    "tsd": "^0.31.2",
    "typescript": "^5.8.3",
    "zod": "^4.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.34.5",
  "files": [
    "index.js",
    "index.d.ts",
    "browser.js",
    "tests.js",
    "tests.d.ts",
    "relations.js",
    "relations.d.ts",
    "src/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "package.json"
  ]
}
